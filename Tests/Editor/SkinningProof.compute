#pragma kernel CheckVertex

#include "Packages/com.sa.unity/Runtime/Shaders/Skinning.hlsl"

float4 _TestPosition;
float4 _TestNormal;
float4 _TestTangent;
float4 _TestSkin;
RWStructuredBuffer<float4> _TestOutput;

[numthreads(1, 1, 1)]
void CheckVertex(uint3 id : SV_DispatchThreadID)
{
    float3 position;
    float3 normal;
    float3 tangent;
    Skin_float(_TestSkin.xy, 0, _TestPosition.xyz, _TestNormal.xyz, _TestTangent.xyz, position, normal, tangent);
    _TestOutput[0] = float4(position, 1);
    _TestOutput[1] = float4(normal, 0);
    _TestOutput[2] = float4(tangent, 0);
}
